# Copy to .env (git-ignored) and fill in.
# Supabase: Project > Connect > "Session pooler" (IPv4-friendly). Use the JDBC form:
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-database-password

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

FRONTEND_ORIGIN=http://localhost:3000
SEED_DEMO_DATA=true

# Food photos (Supabase Storage). Leave the key empty to turn photo uploads off.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=donation-photos
