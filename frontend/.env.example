# Server-only: where Next.js forwards API calls. Never exposed to the browser.
BACKEND_URL=http://localhost:8080

# Optional custom map tiles. Leave unset to use OpenStreetMap (no key needed).
# These are sent to the browser, so only use keys meant to be public (restrict them by domain).
# NEXT_PUBLIC_MAP_TILE_URL=https://.../{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_URL_DARK=https://.../{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO

# Shows a "Simulate movement (demo)" button on the volunteer trip page, for laptop demos without real GPS.
# NEXT_PUBLIC_DEMO_TOOLS=true

# Phone.email "Sign in with Phone" client ID (Admin Dashboard > your button code). Public: it is embedded in the page.
# Leave unset to hide phone sign-in; donors can still use email and password.
# NEXT_PUBLIC_PHONE_EMAIL_CLIENT_ID=
